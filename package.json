{
  "name": "codex-dev-companion",
  "displayName": "Codex Dev Companion",
  "description": "A context-aware development support agent powered by the OpenAI Codex harness.",
  "version": "0.5.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rlsgarcia-code/codex-dev-companion.git"
  },
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=18"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:codexDevCompanion.chat",
    "onCommand:codexDevCompanion.open",
    "onCommand:codexDevCompanion.newThread",
    "onCommand:codexDevCompanion.configureLiteLlm"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "codexDevCompanion",
          "title": "Codex Companion",
          "icon": "media/codex-companion.svg"
        }
      ]
    },
    "views": {
      "codexDevCompanion": [
        {
          "type": "webview",
          "id": "codexDevCompanion.chat",
          "name": "Development Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "codexDevCompanion.open",
        "title": "Codex Companion: Open Agent"
      },
      {
        "command": "codexDevCompanion.newThread",
        "title": "Codex Companion: New Thread"
      },
      {
        "command": "codexDevCompanion.addSelection",
        "title": "Codex Companion: Add Selection to Context"
      },
      {
        "command": "codexDevCompanion.remember",
        "title": "Codex Companion: Remember Note"
      },
      {
        "command": "codexDevCompanion.configureLiteLlm",
        "title": "Codex Companion: Configure LiteLLM"
      },
      {
        "command": "codexDevCompanion.clearLiteLlmKey",
        "title": "Codex Companion: Remove LiteLLM Key"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codexDevCompanion.addSelection",
          "group": "navigation@50",
          "when": "editorHasSelection"
        }
      ],
      "view/title": [
        {
          "command": "codexDevCompanion.newThread",
          "when": "view == codexDevCompanion.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Codex Dev Companion",
      "properties": {
        "codexDevCompanion.liteLlmEndpoint": {
          "type": "string",
          "default": "",
          "description": "HTTPS LiteLLM gateway base URL ending at /v1. Do not include /responses."
        },
        "codexDevCompanion.liteLlmModel": {
          "type": "string",
          "default": "",
          "description": "Exact client-facing model alias configured by the LiteLLM gateway administrator."
        },
        "codexDevCompanion.gatewayCaCertificatePath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Workspace-relative path to an optional gateway CA PEM bundle passed locally to Codex as CODEX_CA_CERTIFICATE."
        },
        "codexDevCompanion.modelCatalogPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Workspace-relative path to an optional Codex model catalog JSON for custom LiteLLM aliases."
        },
        "codexDevCompanion.reasoningEffort": {
          "type": "string",
          "enum": ["minimal", "low", "medium", "high", "xhigh"],
          "default": "high",
          "description": "Reasoning effort used by the development agent."
        },
        "codexDevCompanion.autoContext": {
          "type": "boolean",
          "default": true,
          "description": "Include the active file, selection, diagnostics and workspace summary with each request."
        },
        "codexDevCompanion.maxContextCharacters": {
          "type": "number",
          "default": 24000,
          "minimum": 2000,
          "maximum": 100000,
          "description": "Maximum number of characters collected from the editor for one request."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "npm run compile:tests && node --test dist-tests/test/**/*.test.js",
    "compile:tests": "node scripts/clean-test-output.mjs && tsc -p tsconfig.test.json",
    "smoke:litellm": "npm run compile:tests && node scripts/smoke-litellm-routing.mjs",
    "package": "npm run check && npm run build && vsce package"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.162.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
