{
  "name": "codex-dev-companion",
  "displayName": "Local Dev Companion",
  "description": "A local LangChain development agent connected only to a user-configured LiteLLM Chat Completions endpoint.",
  "version": "0.8.1",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rlsgarcia-code/codex-dev-companion.git"
  },
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:codexDevCompanion.chat",
    "onCommand:codexDevCompanion.open",
    "onCommand:codexDevCompanion.newThread",
    "onCommand:codexDevCompanion.configureLiteLlm"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "codexDevCompanion",
          "title": "Local Companion",
          "icon": "media/codex-companion.svg"
        }
      ]
    },
    "views": {
      "codexDevCompanion": [
        {
          "type": "webview",
          "id": "codexDevCompanion.chat",
          "name": "Development Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "codexDevCompanion.open",
        "title": "Local Companion: Open Agent"
      },
      {
        "command": "codexDevCompanion.newThread",
        "title": "Local Companion: New Thread"
      },
      {
        "command": "codexDevCompanion.addSelection",
        "title": "Local Companion: Add Selection to Context"
      },
      {
        "command": "codexDevCompanion.remember",
        "title": "Local Companion: Remember Note"
      },
      {
        "command": "codexDevCompanion.configureLiteLlm",
        "title": "Local Companion: Configure LiteLLM"
      },
      {
        "command": "codexDevCompanion.clearLiteLlmKey",
        "title": "Local Companion: Remove LiteLLM Key"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codexDevCompanion.addSelection",
          "group": "navigation@50",
          "when": "editorHasSelection"
        }
      ],
      "view/title": [
        {
          "command": "codexDevCompanion.newThread",
          "when": "view == codexDevCompanion.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Local Dev Companion",
      "properties": {
        "codexDevCompanion.agentRuntime": {
          "type": "string",
          "enum": [
            "standard",
            "deep"
          ],
          "enumDescriptions": [
            "Focused LangChain createAgent runtime with explicit local tools and bounded context.",
            "Advanced createDeepAgent runtime with planning support, context compaction, workspace filesystem tools, and local subagents."
          ],
          "default": "standard",
          "scope": "resource",
          "description": "Agent runtime used for this workspace. Both options use the same local LiteLLM Chat Completions connection."
        },
        "codexDevCompanion.liteLlmEndpoint": {
          "type": "string",
          "default": "",
          "description": "HTTPS LiteLLM gateway base URL or complete Chat Completions URL."
        },
        "codexDevCompanion.liteLlmAuthHeader": {
          "type": "string",
          "enum": [
            "authorization",
            "api-key",
            "ocp-apim-subscription-key"
          ],
          "enumDescriptions": [
            "Send the key as Authorization: Bearer, the standard LiteLLM mode.",
            "Send the key in the api-key header used by Azure-compatible gateways.",
            "Send the key in the default Azure API Management subscription header."
          ],
          "default": "authorization",
          "description": "HTTP header used to authenticate the Chat Completions request."
        },
        "codexDevCompanion.liteLlmModel": {
          "type": "string",
          "default": "",
          "description": "Exact client-facing model alias configured by the LiteLLM gateway administrator."
        },
        "codexDevCompanion.gatewayCaCertificatePath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Workspace-relative path to an optional corporate CA PEM bundle used for the LiteLLM HTTPS request."
        },
        "codexDevCompanion.autoContext": {
          "type": "boolean",
          "default": true,
          "description": "Include the active file, selection, diagnostics and workspace summary with each request."
        },
        "codexDevCompanion.maxContextCharacters": {
          "type": "number",
          "default": 24000,
          "minimum": 2000,
          "maximum": 100000,
          "description": "Maximum number of characters collected from the editor for one request."
        },
        "codexDevCompanion.maxConversationCharacters": {
          "type": "number",
          "default": 48000,
          "minimum": 8000,
          "maximum": 200000,
          "description": "Maximum number of recent conversation characters retained as model context."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "npm run compile:tests && node --test dist-tests/test/**/*.test.js",
    "compile:tests": "node scripts/clean-test-output.mjs && tsc -p tsconfig.test.json",
    "smoke:litellm": "npm run compile:tests && node scripts/smoke-litellm-routing.mjs",
    "package": "npm run check && npm run build && vsce package"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/openai": "^1.6.2",
    "deepagents": "^1.15.0",
    "langchain": "^1.5.16",
    "undici": "^6.29.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
